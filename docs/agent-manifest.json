{
  "schema_version": "1.0",
  "product": "data-relationship-map",
  "purpose": "Build an explainable cross-system identity and lineage graph from ordinary enterprise exports.",
  "human_url": "https://dkharlanau.github.io/data-relationship-map/",
  "repository": "https://github.com/dkharlanau/data-relationship-map",
  "boundaries": ["not an ETL engine", "not a master-data hub", "normalization must be explicit", "do not resolve identity collisions or broken links by guesswork", "no direct Transformation Graph, Enterprise Change Graph, or Reconciliation as Code adapter is implemented", "Project Evidence Graph import does not create project requirement bridges"],
  "capabilities": ["ingest CSV/XLSX manifests", "build composite canonical IDs", "validate graph", "detect collisions/conflicts/orphans/broken references", "enforce relationship cardinality", "find identity paths", "traverse directional lineage", "build browser-ready investigation reports", "build and verify bounded integrity-checkable handoffs with artifact indexes", "emit freshness-aware stable eac references", "compare graph snapshots"],
  "entrypoints": [
    {"type":"cli","command":"python csv_adapter.py <manifest.json> --output <graph.json>"},
    {"type":"cli","command":"python relationship_map.py <graph.json> validate"},
    {"type":"cli","command":"python relationship_map.py <graph.json> path <id-a> <id-b>"},
    {"type":"cli","command":"python relationship_lineage.py <graph.json> <id> --direction downstream"},
    {"type":"cli","command":"data-relationship-map handoff build <graph.json> <output-dir> --focus <id> --observed-at <ISO-8601>"},
    {"type":"cli","command":"data-relationship-map handoff verify <output-dir>"},
    {"type":"cli","command":"python relationship_policy.py <graph.json> <policy.json>"}
  ],
  "safe_agent_loop": ["read manifest and normalization rules", "build/validate graph", "surface collisions before path interpretation", "choose identity path or directional lineage explicitly", "apply cardinality policy", "return relationship types and provenance"],
  "related": [
    {"product":"project-evidence-graph","relationship":"implemented consumer of bounded artifact-index.json as external evidence and defects"},
    {"product":"transformation-graph","relationship":"conceptual lineage adjacency; no direct adapter"},
    {"product":"enterprise-change-graph","relationship":"bounded lineage is a candidate input; no direct adapter"}
  ]
}
